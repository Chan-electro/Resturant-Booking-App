# Clerk (GitHub Student Developer Pack can provide Clerk Pro)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/register"

# Supabase Data API and Realtime
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# Supabase Postgres. Use the transaction pooler for Vercel runtime traffic and
# the direct/session-pooler URL for migrations.
DATABASE_URL="postgresql://postgres.YOUR_PROJECT:PASSWORD@REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.YOUR_PROJECT:PASSWORD@REGION.pooler.supabase.com:5432/postgres"

# Comma-separated addresses that become admins on first sign-in.
ADMIN_EMAILS="owner@example.com"

# Optional Razorpay test-mode credentials. Generate these under Razorpay
# Dashboard -> Test mode -> Account & Settings -> API Keys. Never commit a
# real key secret; keep it in apps/web/.env.local or deployment secrets.
RAZORPAY_KEY_ID="rzp_test_REPLACE_WITH_YOUR_KEY_ID"
RAZORPAY_KEY_SECRET="REPLACE_WITH_YOUR_TEST_KEY_SECRET"

# Local/demo fallback when no Razorpay account is available. This simulates a
# successful online payment and must be disabled in any real production setup.
RAZORPAY_MOCK_MODE="false"
